# Backend FastAPI — CHỈ dùng remote encoder (Kaggle, xem AIC_REMOTE_ENCODER_URL),
# nên image nhẹ (không torch/transformers). BẮT BUỘC set 1 LLM API key (Anthropic/
# OpenAI/Gemini) qua env — nếu không, các bước dịch/mở-rộng câu (clauses_en, OCR-
# keyword, ASR-paraphrase, entity resolution) sẽ lỗi vì fallback envit5 cần torch
# (đã bỏ khỏi image này để nhẹ).
FROM python:3.11-slim

WORKDIR /app

# ffmpeg: trích khung hình tại GIÂY BẤT KỲ (GET /media/frame_at) — cần cho
# filmstrip bước 1s/5s và cho việc soi khoảnh khắc rơi GIỮA hai keyframe thưa.
# Không có nó thì hệ thống chỉ xem được đúng 167.850 keyframe đã trích sẵn.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

COPY api ./api
COPY core ./core
COPY config ./config

EXPOSE 8080
ENV PYTHONIOENCODING=utf-8
ENV PYTHONUNBUFFERED=1
CMD ["python", "-m", "uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8080"]
