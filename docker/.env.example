# Copy file này thành ".env" (CÙNG THƯ MỤC docker/, cạnh docker-compose.yml)
# rồi điền giá trị thật. docker compose tự đọc ".env" trong thư mục đang chạy
# lệnh "docker compose" (tức aic-system/docker/), KHÔNG phải aic-system/.

# ---- Bắt buộc: URL/API_KEY in ra khi chạy notebook Kaggle
# indexing/kaggle/11_encode_service.py (xem README.md mục "Chạy encoder Kaggle").
# Đổi lại MỖI LẦN bạn khởi động lại notebook Kaggle (URL ngrok đổi mỗi phiên).
AIC_REMOTE_ENCODER_URL=https://xxxx-xx-xxx-xxx-xxx.ngrok-free.app
AIC_REMOTE_ENCODER_KEY=dan_vao_day

# ---- Bắt buộc CHỌN 1: ít nhất 1 LLM key (dùng cho dịch câu/mở rộng câu/OCR-
# keyword/ASR-paraphrase/entity resolution — không có key nào thì các bước này
# bị tắt, hệ thống vẫn chạy nhưng chỉ còn tìm bằng hình ảnh thuần (metaclip2/
# pecore/beit3/capemb), không xử lý câu tiếng Việt được đầy đủ).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Tùy chọn: master key cho Meilisearch (để trống = chạy không khoá, chỉ nên
# để trống khi chạy local/LAN riêng tư, không expose ra ngoài).
AIC_MEILI_KEY=

# ---- Chung kết DRES: chỉ địa chỉ server (không ghi tài khoản/sessionId vào .env).
# Đổi nếu BTC cung cấp URL khác. Backend chỉ chấp nhận HTTPS.
AIC_DRES_BASE_URL=https://eventretrieval.one

# ---- Tùy chọn: video gốc nằm ở nhiều ổ/thư mục
# Các giá trị ở đây là đường dẫn BÊN TRONG container, phân cách bằng dấu ":".
# Đồng thời bind-mount từng thư mục host vào backend.volumes trong
# docker-compose.yml (xem ví dụ ở file đó). Thứ tự quyết định độ ưu tiên nếu
# hai thư mục có file video trùng tên.
# AIC_VIDEO_DIRS=/videos-a:/videos-b

# Video phát qua CloudFront (S3 Singapore, video nằm ở gốc bucket).
# Để trống nếu muốn chỉ dùng video trên đĩa local.
AIC_VIDEO_CDN_BASE_URL=https://d14le8uni46xsj.cloudfront.net
AIC_KEYFRAME_CDN_BASE_URL=
# Nguồn keyframe/maps: auto (local trước, thiếu thì CDN) | local (chỉ đĩa) | s3 (chỉ CDN)
AIC_KEYFRAME_SOURCE=s3
